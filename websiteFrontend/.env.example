# Copy this file to .env and fill in values from Firebase Console
# Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database URL for live animal data (animals/COW001/latest, animals/COW002/latest).
# Same Firebase project as Auth: set this to your RTDB URL, e.g.
# VITE_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
# (use your regional URL if different, e.g. https://<project-id>-default-rtdb.asia-southeast1.firebasedatabase.app)
VITE_FIREBASE_DATABASE_URL=
# If the Raspberry Pi writes to a DIFFERENT Firebase project than Auth, use these instead:
# VITE_HW_DATABASE_URL=
# VITE_HW_API_KEY=
# VITE_HW_PROJECT_ID=
# VITE_HW_APP_ID=
# VITE_HW_AUTH_DOMAIN=
